# Copy to .env (next to docker-compose.yml) and fill in as needed.
# Every value here is optional — with no .env at all the stack still runs,
# using Leaflet/OpenStreetMap and with the admin gate disabled.

# Password gating the "Начать игру" and "Наборы" admin buttons.
# Leave unset to disable the gate (fine for local dev).
LOCOGUESS_ADMIN_PASSWORD=

# Map provider: "leaflet" (default, free, no key) or "google".
VITE_MAP_PROVIDER=leaflet

# Required only when VITE_MAP_PROVIDER=google.
VITE_GOOGLE_MAPS_API_KEY=
